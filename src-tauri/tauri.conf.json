{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COMO Desk",
  "version": "1.3.0",
  "identifier": "cafe.como.desk",
  "build": {
    "beforeDevCommand": "npm run build:tauri && npm run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../.vercel/output/static"
  },
  "app": {
    "windows": [
      {
        "title": "COMO Desk",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
